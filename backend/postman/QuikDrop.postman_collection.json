{
  "info": {
    "name": "QuikDrop API",
    "description": "QuikDrop backend, Stage 2D. Import together with the `QuikDrop Local` environment. Run requests top-to-bottom: login requests capture tokens, and create requests capture ids for later calls. Requires `npm run db:reset` (seeded accounts) and a running server.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health",
            "description": "Liveness probe. No auth required."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('health 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('status ok', function () { pm.expect(pm.response.json().data.status).to.eql('ok'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/register (customer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Customer\",\n  \"email\": \"postman.customer@quikdrop.test\",\n  \"phone\": \"+254700000001\",\n  \"password\": \"Password123!\",\n  \"role\": \"CUSTOMER\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Self-register a customer. Returns `{ token, user }`. Re-running with the same email returns 409."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('register 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.token) {",
                  "  pm.environment.set('customerToken', json.data.token);",
                  "  if (json.data.user) { pm.environment.set('customerId', json.data.user.id); }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/register (rider)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Rider\",\n  \"email\": \"postman.rider@quikdrop.test\",\n  \"phone\": \"+254700000002\",\n  \"password\": \"Password123!\",\n  \"role\": \"RIDER\",\n  \"vehicleType\": \"Motorbike\",\n  \"plateNumber\": \"KDA 123A\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Self-register a rider. Also creates a rider profile (availability OFFLINE)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('register rider 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.token) {",
                  "  pm.environment.set('riderToken', json.data.token);",
                  "  if (json.data.user) { pm.environment.set('riderId', json.data.user.id); }",
