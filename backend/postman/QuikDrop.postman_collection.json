            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupAddress\": \"123 Kenyatta Avenue, Nairobi\",\n  \"pickupContactName\": \"Alice Mwangi\",\n  \"pickupContactPhone\": \"+254711111111\",\n  \"dropoffAddress\": \"45 Ngong Road, Nairobi\",\n  \"dropoffContactName\": \"Bob Otieno\",\n  \"dropoffContactPhone\": \"+254722222222\",\n  \"packageDescription\": \"Small parcel with documents\",\n  \"packageWeightKg\": 3,\n  \"notes\": \"Handle with care\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/deliveries",
            "description": "Create a delivery. Price is computed server-side (`basePrice + pricePerKg * weight`). Captures `deliveryId`. Sending `price`/`status` is a 400."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('create delivery 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.delivery) { pm.environment.set('deliveryId', json.data.delivery.id); }"
                ]
              }
            }
          ]
        },
