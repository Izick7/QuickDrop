# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database (individual vars used in development) ----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=quikdrop_dev
DB_USER=postgres
DB_PASSWORD=postgres

# Optional test database (defaults to ${DB_NAME}_test)
DB_NAME_TEST=quikdrop_test

# ---- Database (production connection string, takes precedence) ----
# Example: postgres://user:password@host:5432/quikdrop_prod?sslmode=require
DATABASE_URL=

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
