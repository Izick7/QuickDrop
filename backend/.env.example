# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database (individual vars used in development) ----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=quikdrop_dev
DB_USER=postgres
DB_PASSWORD=postgres

# Optional test database (defaults to ${DB_NAME}_test)
DB_NAME_TEST=quikdrop_test

# ---- Database (production connection string, takes precedence) ----
# Example: postgres://user:password@host:5432/quikdrop_prod?sslmode=require
DATABASE_URL=

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
# Max auth requests (register/login) per 15-minute window, per IP.
AUTH_RATE_LIMIT_MAX=100

# ---- HTTP ----
# Comma-free origin allowed by CORS. Use an explicit origin in production
# ("*" is rejected at startup when NODE_ENV=production).
CORS_ORIGIN=*
# Trust the X-Forwarded-* headers from a reverse proxy. Off by default.
# Accepts true/false, a hop count (e.g. 1), or an Express value like "loopback".
TRUST_PROXY=
